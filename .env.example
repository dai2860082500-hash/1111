# 企业微信群助手环境变量配置

# ========== 必需配置 ==========
# 企业微信 Webhook URL（必填）
# 获取方法：企业微信群 → 右键 → 添加群机器人 → 复制 Webhook URL
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# ========== 可选配置 ==========

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# 日志文件路径
LOG_FILE=logs/wecom-robot.log

# 消息发送失败时的最大重试次数
MAX_RETRIES=3

# 重试延迟时间（毫秒）
RETRY_DELAY=2000

# 时区设置
TIMEZONE=Asia/Shanghai

# 运行环境 (production, development)
NODE_ENV=production
